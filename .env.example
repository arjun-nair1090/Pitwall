# Copy this file to .env and fill in real values before running the app.
# `docker-compose up` reads this file automatically via env_file/environment config.

# --- Security ---
# Required. The app raises ValueError at import time if this is unset.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_secret

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=f1password
POSTGRES_DB=f1_pitwall
# Use "postgres" (the docker-compose service name) inside Docker, "localhost" when running the backend locally.
POSTGRES_HOST=postgres

# --- Redis ---
# Use "redis://redis:6379/0" inside Docker, "redis://localhost:6379/0" when running locally.
REDIS_URL=redis://redis:6379/0

# --- LLM providers (AI Race Engineer / AI Commentator) ---
# At least one of these should be set for AI features to return real model output;
# without either, endpoints fall back to a static/rule-based response.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- FastF1 ---
FASTF1_SESSION_TYPE=Race
FASTF1_YEAR=2024
FASTF1_CACHE_DIR=data/fastf1_cache

# --- ChromaDB (AI Race Engineer historical RAG) ---
# Use "chromadb" (the docker-compose service name) inside Docker, "localhost" when running locally.
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- API / CORS ---
API_V1_STR_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Local (non-Docker) dev ---
# Set to "true" when running the backend directly on your host (outside docker-compose),
# so DATABASE_URL/REDIS_URL resolve to localhost instead of the Docker service names.
RUNNING_LOCALLY=false
