# HTTPS in front of the backend for docker-compose.prod.yml. Caddy fetches and renews the certificate.
{$API_DOMAIN} {
	# Requests forwarded by the site carry PROXY_SECRET and the visitor's IP; only then is that IP
	# passed on, so the rate limits count visitors. Anyone else is counted by the address they connect from.
	@site {
		header X-Pitwall-Proxy {$PROXY_SECRET}
		header_regexp X-Pitwall-Client-Ip ^[0-9A-Fa-f.:]+$
	}
	handle @site {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {http.request.header.X-Pitwall-Client-Ip}
			header_up -X-Pitwall-Proxy
		}
	}
	handle {
		reverse_proxy backend:8000 {
			header_up -X-Pitwall-Client-Ip
		}
	}
}
